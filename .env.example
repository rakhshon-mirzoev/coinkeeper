HTTP_ADDR=:8080
DATABASE_URL=postgres://coinkeeper:coinkeeper@localhost:5433/coinkeeper?sslmode=disable
LOG_LEVEL=debug

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Часовой пояс семьи: от него считаются «сегодня», «вчера», «этот месяц»
TZ=Europe/Moscow

# LLM: любой OpenAI-совместимый API — OpenRouter, Cloud.ru, OpenAI, Ollama.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Ключ: https://openrouter.ai/keys
LLM_API_KEY=
# Модель с поддержкой tool calling; бесплатные на OpenRouter оканчиваются на :free
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

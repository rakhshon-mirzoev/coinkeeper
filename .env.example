HTTP_ADDR=:8080
DATABASE_URL=postgres://coinkeeper:coinkeeper@localhost:5433/coinkeeper?sslmode=disable
LOG_LEVEL=debug

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram ID членов семьи через запятую; пусто — бот отвечает всем
ALLOWED_USER_IDS=
# Часовой пояс семьи: от него считаются «сегодня», «вчера», «этот месяц»
TZ=Europe/Moscow

# Ключ Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Глубина размышлений модели: low, medium, high
LLM_EFFORT=medium

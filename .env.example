HTTP_ADDR=:8080
DATABASE_URL=postgres://coinkeeper:coinkeeper@localhost:5433/coinkeeper?sslmode=disable
LOG_LEVEL=debug

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Код ссылки-приглашения t.me/<бот>?start=<код>: 8-64 символа, латиница, цифры, _ и -.
# Пусто — бот отвечает всем. Сгенерировать: openssl rand -hex 12.
# Ссылка печатается в лог бота при запуске.
FAMILY_INVITE_CODE=
# Часовой пояс семьи: от него считаются «сегодня», «вчера», «этот месяц»
TZ=Europe/Moscow

# LLM. openai — любой OpenAI-совместимый API: OpenRouter, Cloud.ru, OpenAI, Ollama.
# anthropic — Claude API (LLM_BASE_URL не нужен, LLM_MODEL по умолчанию claude-opus-5-5).
LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
# Ключ: https://openrouter.ai/keys
LLM_API_KEY=
# Модель с поддержкой tool calling; бесплатные на OpenRouter оканчиваются на :free
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Только для anthropic: low, medium, high
LLM_EFFORT=
